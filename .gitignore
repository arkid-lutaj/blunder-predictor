.venv/
__pycache__/
.ipynb_checkpoints/

# Bulk data never goes in git
data/*
*.zst
*.csv

# ...except the small committed samples the repo needs to be runnable
!data/sample_positions.parquet
!data/sample_games.pgn

# Models: keep only the final one
models/*
!models/final_model.txt

# The Stockfish binary: 111 MB, and it is a redistributable third-party build,
# not this project's source. tools/README should say which release to fetch.
tools/

# Run logs. Useful while a job is in flight, worthless in history, and they
# hold absolute local paths.
logs/

# Scratch. Anything here is a working copy of something that belongs in src/.
temporary files/

# Stale duplicates of reports/report_*.txt, left at the root by an early run.
/report_blitz.txt
/report_rapid.txt

# Personal build plan, not part of the public repo
RUNBOOK.md

# make test output
build/
